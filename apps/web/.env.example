# OAuth Providers (optional, for future use)
# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_ID=
# GOOGLE_SECRET=

# Email (to be configured)
# EMAIL_PROVIDER_KEY=
# EMAIL_FROM_ADDRESS=

# Deployment
NODE_ENV="development"
