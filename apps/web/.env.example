# OAuth Providers (optional, for future use)
# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_ID=
# GOOGLE_SECRET=

# Email (to be configured)
# For development/testing, use EMAIL_PROVIDER_KEY="test"
# For production, get RESEND_API_KEY from https://resend.com
RESEND_API_KEY="test"
EMAIL_FROM_ADDRESS="noreply@brotherjimi.com"

# Prayer Call System (Whereby video conferencing)
# Whereby room URL for live prayer call encounters
WHEREBY_ROOM_URL="https://whereby.com/themanondmount"

# Deployment
NODE_ENV="development"
