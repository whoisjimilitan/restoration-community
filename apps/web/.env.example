# Database
DATABASE_URL="postgresql://user:password@localhost:5432/restoration_community"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth.js (Auth.js)
NEXTAUTH_URL="http://localhost:3000"
