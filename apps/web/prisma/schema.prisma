// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authentication: User manages email, password, sessions
model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  emailVerified         DateTime?
  password              String
  name                  String?
  firstName             String?
  lastName              String?
  role                  Role      @default(VISITOR)
  onboardingCompleted   Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relationships
  profile                Profile?
  userRestoration        UserRestoration?
  transitionsApproved    StageTransition[]
  resourcesCreated       Resource[] @relation("ResourceCreator")
  resourcesApproved      Resource[] @relation("ResourceApprover")
  sessions               Session[]
  accounts               Account[]

  // Prayer ministry relationships
  prayerRequests         PrayerRequest[]
  prayerWarrior          PrayerWarrior?
  prayerResponses        PrayerResponse[]

  // Entry pathway relationships (ENTRY-001)
  entryEncounters        EntryPrayerRequest[] @relation("EntryEncounters")
  entryConversions       EntryPrayerRequest[] @relation("EntryConversions")

  // Onboarding relationships (ONBOARD-002)
  signupTokensCreated    OneTimeSignupToken[]

  // Deliverance intake
  deliveranceIntake      DeliveranceIntake?

  // Content generation relationships
  contentPlans           ContentPlan[] @relation("ContentPlans")
  processedSources       ProcessedSource[] @relation("ProcessedSources")

  // Mentor relationships (COHORT-001)
  mentoringAssignments   MentorAssignment[] @relation("MentorOf")

  // Prayer call relationships (PRAYER-CALL-001)
  prayerCallsWithBrotherJimi PrayerCall[] @relation("PrayerCallsWithBrotherJimi")
  prayerCallsAsUser      PrayerCall[] @relation("PrayerCallsAsUser")

  // Program relationships (PROGRAM-001)
  programsFacilitated    Program[] @relation("ProgramsFacilitated")
  programParticipations  ProgramParticipant[] @relation("ProgramParticipants")
  programMentorships     ProgramParticipant[] @relation("ProgramMentors")

  // Facilitator profile (FACILITATOR-001)
  facilitatorProfile     Facilitator? @relation("UserAsFacilitator")

  // Testimony videos (TESTIMONY-001)
  testimonyVideos        TestimonyVideo[] @relation("TestimoniesAsParticipant")

  // Content engine (CONTENT-ENGINE-V3)
  contentInputs          ContentInput[]

  @@map("users")
}

// Deliverance entry pathway intake form
model DeliveranceIntake {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  situation             String    // Current involvement status
  seeking               String[]  @default([]) // What they're seeking from Jesus
  story                 String    @db.Text // Their story/background
  readiness             String    // Readiness to leave lifestyle
  contact               String    // Phone/WhatsApp contact
  state                 String?   // State or region
  country               String?   // Country of residence

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("deliverance_intakes")
}

// Ministry Data: Profile manages restoration-specific information
model Profile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName           String
  preferredName         String?
  countryRegion         String?
  timeZone              String?
  bio                   String?
  profilePhotoUrl       String?
  covenantAccepted      Boolean  @default(false)
  covenantAcceptedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

// Auth.js Sessions
model Session {
  id        String   @id @default(cuid())
  sessionToken String  @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

// Auth.js Accounts (for OAuth in future)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Email Verification Tokens
model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// Role-based authorization
enum Role {
  VISITOR
  PARTICIPANT
  MENTOR
  COMMUNITY_LEADER
  ADMIN
}

// Restoration Journey: The seven immutable stages
model RestorationStage {
  id        Int      @id @default(autoincrement())
  key       String   @unique // "truth", "confession", "repentance", etc.
  name      String   // "Truth", "Confession", etc.
  sequence  Int      @unique // 1-7, enforces order

  content             StageContent?
  currentStageUsers   UserRestoration[] @relation("CurrentStage")
  fromTransitions     StageTransition[] @relation("FromStage")
  toTransitions       StageTransition[] @relation("ToStage")
  reflections         StageReflection[]
  stageResources      StageResource[]
  meetings            Meeting[]

  @@index([sequence])
  @@map("restoration_stages")
}

// Editable teaching material for each stage (versionable)
model StageContent {
  id          Int     @id @default(autoincrement())
  stageId     Int     @unique
  stage       RestorationStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  description String  // Full description of the stage
  scripture   String? // Key scriptures
  guidance    String? // Pastoral guidance
  resources   Json?   // Future-proof: PDF URLs, video links, lesson IDs, etc.

  version     Int     @default(1)
  createdAt   DateTime @default(now())
  publishedAt DateTime? // When this version was published
  updatedAt   DateTime @updatedAt

  @@map("stage_content")
}

// User's restoration journey (one per user)
model UserRestoration {
  id              Int     @id @default(autoincrement())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentStageId  Int
  currentStage    RestorationStage @relation("CurrentStage", fields: [currentStageId], references: [id])

  // Cohort participation (COHORT-001)
  cohortId        String?
  cohort          Cohort? @relation("CohortParticipants", fields: [cohortId], references: [id])

  // Program participation (PROGRAM-001)
  programId       String?

  // Sponsorship reference (SPONSOR-001)
  sponsorId       String?

  // Mentor reference (MENTOR-001)
  mentorId        String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transitions     StageTransition[]
  reflections     StageReflection[]
  attendances     Attendance[]
  mentorAssignments MentorAssignment[]

  @@map("user_restorations")
}

// Immutable history of stage progressions
model StageTransition {
  id                  Int     @id @default(autoincrement())
  userRestorationId   Int
  userRestoration     UserRestoration @relation(fields: [userRestorationId], references: [id], onDelete: Cascade)

  fromStageId         Int
  fromStage           RestorationStage @relation("FromStage", fields: [fromStageId], references: [id])

  toStageId           Int
  toStage             RestorationStage @relation("ToStage", fields: [toStageId], references: [id])

  transitionedAt      DateTime @default(now())
  transitionedById    String?
  transitionedBy      User?    @relation(fields: [transitionedById], references: [id], onDelete: SetNull)
  reason              String?  // Why the transition occurred

  createdAt           DateTime @default(now())

  @@index([userRestorationId])
  @@index([transitionedAt])
  @@map("stage_transitions")
}

// User reflections at each stage (stackable)
model StageReflection {
  id                  Int     @id @default(autoincrement())
  userRestorationId   Int
  userRestoration     UserRestoration @relation(fields: [userRestorationId], references: [id], onDelete: Cascade)

  stageId             Int
  stage               RestorationStage @relation(fields: [stageId], references: [id])

  reflection          String  // User's personal note/reflection
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userRestorationId])
  @@index([stageId])
  @@map("stage_reflections")
}

// ============================================================================
// CONTENT FOUNDATION
// ============================================================================
// Flexible, versionable, publishable content system
// Supports: Scripture, Teaching, Video, PDF, Reflection Question, Prayer, Assignment, External Link

enum ResourceType {
  SCRIPTURE
  TEACHING
  VIDEO
  PDF
  REFLECTION_QUESTION
  PRAYER
  ASSIGNMENT
  EXTERNAL_LINK
}

model ResourceCategory {
  id          String @id @default(cuid())
  name        String @unique
  description String?

  resources   Resource[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("resource_categories")
}

model Resource {
  id          String @id @default(cuid())
  title       String
  slug        String @unique
  description String?
  type        ResourceType

  // Content storage
  content           String? @db.Text // For teachings, reflections, prayers
  scriptureReference String? // For scriptures (e.g., "John 8:31-32")
  url               String? // For external links, videos
  videoUrl          String? // Specific for videos
  videoDuration     Int? // Duration in seconds for videos

  // Metadata
  categoryId        String?
  category          ResourceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  author            String?
  source            String? // internal, external, bible.com, etc.

  // Versioning & Publishing
  version           Int @default(1)
  isDraft           Boolean @default(true)
  isPublished       Boolean @default(false)
  publishedAt       DateTime?
  isRetired         Boolean @default(false)
  retiredAt         DateTime?

  // Content workflow
  createdById       String?
  createdBy         User? @relation("ResourceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  approvedById      String?
  approvedBy        User? @relation("ResourceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?

  // Relationships
  stageResources    StageResource[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([type])
  @@index([isDraft])
  @@index([isPublished])
  @@map("resources")
}

model StageResource {
  id          String @id @default(cuid())
  stageId     Int
  stage       RestorationStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  resourceId  String
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  // Control display and importance
  order       Int @default(0) // For ordering resources within a stage
  isRequired  Boolean @default(false) // Essential for stage progression

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([stageId, resourceId])
  @@index([stageId])
  @@index([resourceId])
  @@map("stage_resources")
}

// ============================================================================
// PRAYER MINISTRY FOUNDATION (PRAYER-001)
// ============================================================================
// Private prayer request system supporting Brother Jimi's prayer ministry
// Authority: GOV-002 (Restoration Prayer Ministry Principle)

enum PrayerStatus {
  SUBMITTED
  RECEIVED
  IN_PRAYER
  FOLLOW_UP_REQUIRED
  COMPLETED
}

// Prayer request submitted by participant to Brother Jimi's prayer ministry
model PrayerRequest {
  id            String   @id @default(cuid())
  participantId String
  participant   User     @relation(fields: [participantId], references: [id], onDelete: Cascade)

  content       String   @db.Text // Prayer request text
  status        PrayerStatus @default(SUBMITTED)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationships
  assignments   PrayerAssignment[]
  responses     PrayerResponse[]

  @@index([participantId])
  @@index([status])
  @@index([createdAt])
  @@map("prayer_requests")
}

// Prayer warrior: approved servant in prayer ministry (invisible to participants)
model PrayerWarrior {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relationships
  assignments PrayerAssignment[]

  @@index([approved])
  @@map("prayer_warriors")
}

// Assignment of prayer warriors to specific prayer requests
model PrayerAssignment {
  id              String   @id @default(cuid())
  prayerRequestId String
  prayerRequest   PrayerRequest @relation(fields: [prayerRequestId], references: [id], onDelete: Cascade)

  prayerWarriorId String
  prayerWarrior   PrayerWarrior @relation(fields: [prayerWarriorId], references: [id], onDelete: Cascade)

  assignedAt      DateTime @default(now())

  @@unique([prayerRequestId, prayerWarriorId])
  @@index([prayerRequestId])
  @@index([prayerWarriorId])
  @@map("prayer_assignments")
}

// Record that prayer ministry action occurred (not prayer content or effectiveness)
model PrayerResponse {
  id              String   @id @default(cuid())
  prayerRequestId String
  prayerRequest   PrayerRequest @relation(fields: [prayerRequestId], references: [id], onDelete: Cascade)

  recordedById    String
  recordedBy      User     @relation(fields: [recordedById], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([prayerRequestId])
  @@index([recordedById])
  @@index([createdAt])
  @@map("prayer_responses")
}

// ============================================================================
// ENTRY PRAYER REQUESTS (ENTRY-001)
// ============================================================================
// Unauthenticated seekers requesting prayer/deliverance
// First touchpoint in the restoration funnel

enum EntrySituation {
  CURRENTLY_INVOLVED
  PAST_INVOLVED
  STRUGGLING_TO_LEAVE
  AFFECTED_BY_LIFESTYLE
  OTHER
}

enum EntryReadiness {
  YES_READY
  WANT_TO_BE_READY
  NEED_HELP
}

enum EntryRequestStatus {
  SUBMITTED
  RECEIVED
  SCHEDULED
  COMPLETED
}

model EntryPrayerRequest {
  id            String   @id @default(cuid())

  // Seeker Information
  name          String
  contact       String   // Phone or email
  country       String?

  // Situation Assessment
  situation     EntrySituation
  seeking       String[] @default([]) // JSON array of what they're seeking
  story         String   @db.Text // Their story/testimony
  readiness     EntryReadiness

  // Status & Workflow
  status        EntryRequestStatus @default(SUBMITTED)

  // Encounter tracking (will be filled during ENCOUNTER-001)
  encounteredAt DateTime?
  encounteredById String?
  encounteredBy  User?    @relation("EntryEncounters", fields: [encounteredById], references: [id], onDelete: SetNull)

  decisionMade  Boolean  @default(false) // Did they say yes to restoration journey?
  decision      String?  // "yes", "no", "need_more_time"

  // Conversion to participant (ONBOARD-002)
  convertedToUserId String?
  convertedToUser   User?   @relation("EntryConversions", fields: [convertedToUserId], references: [id], onDelete: SetNull)
  convertedAt   DateTime?

  // Onboarding token
  signupToken   OneTimeSignupToken?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([contact])
  @@map("entry_prayer_requests")
}

// ============================================================================
// ONBOARDING TOKENS (ONBOARD-002)
// ============================================================================
// One-time signup tokens for seekers transitioning to participants
// Generated after encounter decision = YES

model OneTimeSignupToken {
  id            String   @id @default(cuid())

  // Seeker information (pre-account)
  entryRequestId String   @unique
  entryRequest   EntryPrayerRequest @relation(fields: [entryRequestId], references: [id], onDelete: Cascade)

  // Token details
  token         String   @unique @default(cuid()) // Unique, random token
  expiresAt     DateTime
  usedAt        DateTime?

  // Account created from this token
  createdUserId String?
  createdUser   User?    @relation(fields: [createdUserId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())

  @@index([token])
  @@index([entryRequestId])
  @@index([expiresAt])
  @@map("onetime_signup_tokens")
}

// ============================================================================
// TESTIMONIES SYSTEM
// ============================================================================
// Dynamic testimonies with image galleries and proof of transformation

model Testimony {
  id        String   @id @default(cuid())
  name      String
  role      String   // e.g., "Former Scammer", "Student"
  stage     Int      // 1-7
  quote     String   // Main quote for card
  story     String   @db.Text // Full narrative
  heroImage TestimonyImage? @relation("heroImage")
  heroImageId String? @unique
  proofImages TestimonyImage[] @relation("proofImages")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonies")
}

model TestimonyImage {
  id         String   @id @default(cuid())
  url        String   // Cloudinary/Vercel Blob URL
  alt        String   // Alt text
  type       String   // "hero" | "proof" | "evidence"
  heroTestimony  Testimony? @relation("heroImage", fields: [heroImageId], references: [id], onDelete: Cascade)
  heroImageId String? @unique
  proofTestimonies Testimony[] @relation("proofImages")
  createdAt DateTime @default(now())

  @@map("testimony_images")
}

// ============================================================================
// CONTENT GENERATION ENGINE (Identity-Centered Content)
// ============================================================================
// Tracks daily content generation plans, outputs, and source processing
// Supports: daily letters, social posts, micro-insights, devotionals, articles, videos, podcasts, emails

model ContentPlan {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  identityChoice Int     // Which of the 7 identity choices (1-7)
  identityLabel String   // Label like "Truth vs Deception"
  sourceType    String   // "wordpress" | "podcast" | "facebook" | "raw"
  sourceUrl     String?  // Optional source URL
  sourceTitle   String   // Title of the source
  sourceExcerpt String   @db.Text // Excerpt from source
  revelation    String   @db.Text // The revelation extracted
  frame         String?  // Frame from v2 pipeline: counsel | advise | uplift | enlighten | educate
  conversationalEntry String? @db.Text // Conversational opening from v2 pipeline
  outputs       ContentOutput[] // Relationship to outputs
  status        String   @default("draft") // "draft" | "published" | "scheduled"
  publishedAt   DateTime? // When published
  userId        String   // Foreign key to User
  user          User     @relation("ContentPlans", fields: [userId], references: [id], onDelete: Cascade)
  updatedAt     DateTime @updatedAt

  @@map("content_plans")
}

model ContentOutput {
  id            String   @id @default(cuid())
  format        String   // "daily-letter" | "social-post" | "micro-insight" | "devotional" | "article" | "short-video" | "long-video" | "podcast-moment" | "email"
  content       String   @db.Text // The generated content
  title         String?  // Optional title
  wordCount     Int?     // Optional word count
  duration      String?  // For videos/audio
  publishedUrl  String?  // Where it was published
  publishedAt   DateTime? // When published
  contentPlan   ContentPlan @relation(fields: [contentPlanId], references: [id], onDelete: Cascade)
  contentPlanId String   // Foreign key
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("content_outputs")
}

model ProcessedSource {
  id            String   @id @default(cuid())
  sourceType    String   // "wordpress" | "podcast" | "facebook"
  sourceKey     String   // URL or post ID
  sourceTitle   String
  sequence      Int?     // For alphabetical ordering
  processed     Boolean  @default(false)
  processedAt   DateTime?
  identityChoice Int?
  userId        String   // Foreign key to User
  user          User     @relation("ProcessedSources", fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([sourceType, sourceKey, userId])
  @@map("processed_sources")
}

// ============================================================================
// COHORT MANAGEMENT (COHORT-001)
// ============================================================================
// Tracks groups of participants progressing through 7-week restoration journey

model Cohort {
  id              String   @id @default(cuid())
  name            String   // "Cohort 1", "Cohort 2", etc.
  description     String?
  startDate       DateTime // When cohort begins (e.g., Aug 8, 2026)
  endDate         DateTime // When cohort completes (e.g., Sept 19, 2026)
  targetSize      Int      // Number of participants (typically 15)
  status          String   @default("planning") // planning, active, completed

  // Relationships
  participants    UserRestoration[] @relation("CohortParticipants")
  meetings        Meeting[]
  mentorAssignments MentorAssignment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cohorts")
}

// ============================================================================
// MEETINGS (MEETING-001)
// ============================================================================
// Weekly Friday 3pm gatherings at SCOAN Accra for each stage

model Meeting {
  id              String   @id @default(cuid())
  cohortId        String
  cohort          Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  stageId         Int
  stage           RestorationStage @relation(fields: [stageId], references: [id])

  weekNumber      Int      // 1-7
  scheduledDate   DateTime // Friday 3pm SCOAN Accra
  location        String   @default("SCOAN Accra, Ghana")
  time            String   @default("3:00 PM")

  recordingUrl    String?  // Video link after meeting
  recordingNotes  String?  @db.Text

  // Relationships
  attendances     Attendance[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([cohortId, stageId, weekNumber])
  @@index([cohortId])
  @@index([stageId])
  @@map("meetings")
}

// ============================================================================
// ATTENDANCE TRACKING (ATTENDANCE-001)
// ============================================================================
// Tracks who attended which meeting and their engagement

model Attendance {
  id              String   @id @default(cuid())
  meetingId       String
  meeting         Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  userRestorationId Int
  userRestoration UserRestoration @relation(fields: [userRestorationId], references: [id], onDelete: Cascade)

  attended        Boolean  @default(false)
  arrivedAt       DateTime? // Actual arrival time
  departedAt      DateTime? // When they left

  notes           String?  @db.Text // Mentor notes on participation
  status          String   @default("pending") // pending, attended, absent, excused

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([meetingId, userRestorationId])
  @@index([meetingId])
  @@index([userRestorationId])
  @@map("attendances")
}

// ============================================================================
// MENTOR ASSIGNMENTS (MENTOR-001)
// ============================================================================
// Tracks mentor-mentee relationships for accountability & prayer support

model MentorAssignment {
  id              String   @id @default(cuid())
  cohortId        String
  cohort          Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  mentorUserId    String
  mentor          User     @relation("MentorOf", fields: [mentorUserId], references: [id], onDelete: Cascade)

  menteeUserRestorationId Int
  mentee          UserRestoration @relation(fields: [menteeUserRestorationId], references: [id], onDelete: Cascade)

  assignedAt      DateTime @default(now())
  status          String   @default("active") // active, paused, completed

  // Prayer & accountability tracking
  lastCheckIn     DateTime?
  checkInNotes    String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([cohortId, mentorUserId, menteeUserRestorationId])
  @@index([cohortId])
  @@index([mentorUserId])
  @@index([menteeUserRestorationId])
  @@map("mentor_assignments")
}

// ============================================================================
// PRAYER CALLS (PRAYER-CALL-001)
// ============================================================================
// One-on-one prayer calls with Brother Jimi for personalized prayer ministry

model PrayerCall {
  id              String   @id @default(cuid())

  // Participants
  brotherJimiId   String
  brotherJimi     User     @relation("PrayerCallsWithBrotherJimi", fields: [brotherJimiId], references: [id], onDelete: Cascade)

  userId          String
  user            User     @relation("PrayerCallsAsUser", fields: [userId], references: [id], onDelete: Cascade)

  // Call details
  status          String   @default("scheduled") // scheduled, completed, no-show, cancelled
  scheduledTime   DateTime

  // Recording & consent
  wherebyRoomUrl  String?  // Whereby video conference room URL
  recordingUrl    String?  // Supabase Storage URL for recording
  consentGiven    Boolean  @default(false) // User consented to recording

  // Follow-up
  notes           String?  @db.Text // Brother Jimi's notes after call

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([scheduledTime])
  @@index([brotherJimiId])
  @@index([userId])
  @@map("prayer_calls")
}

// ============================================================================
// PROGRAMS (PROGRAM-001)
// ============================================================================
// School, church, workplace, and retreat programs for restoration workshops

model Program {
  id              String   @id @default(cuid())

  // Program details
  name            String
  format          String   // school, church, retreat, workplace
  location        String
  description     String?  @db.Text

  // Timeline
  startDate       DateTime
  endDate         DateTime

  // Capacity & status
  targetSize      Int      // Expected number of participants
  status          String   @default("planning") // planning, active, completed

  // Facilitator
  facilitatorId   String
  facilitator     User     @relation("ProgramsFacilitated", fields: [facilitatorId], references: [id], onDelete: Cascade)

  // Relationships
  participants    ProgramParticipant[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([facilitatorId])
  @@index([startDate])
  @@map("programs")
}

// ============================================================================
// PROGRAM PARTICIPANTS (PROGRAM-PARTICIPANT-001)
// ============================================================================
// Tracks individuals participating in programs, including sponsors and mentors

model ProgramParticipant {
  id              String   @id @default(cuid())

  programId       String
  program         Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  userId          String
  user            User     @relation("ProgramParticipants", fields: [userId], references: [id], onDelete: Cascade)

  // Optional sponsor
  sponsorId       String?
  sponsor         Sponsor? @relation(fields: [sponsorId], references: [id], onDelete: SetNull)

  // Optional mentor
  mentorId        String?
  mentor          User?    @relation("ProgramMentors", fields: [mentorId], references: [id], onDelete: SetNull)

  // Participation tracking
  attendanceStatus String  @default("registered") // registered, attended, completed

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([programId, userId])
  @@index([programId])
  @@index([userId])
  @@index([attendanceStatus])
  @@map("program_participants")
}

// ============================================================================
// SPONSORS (SPONSOR-001)
// ============================================================================
// Tracks financial sponsors for program participants

model Sponsor {
  id              String   @id @default(cuid())

  // Sponsor information
  name            String
  email           String   @unique
  phone           String?

  // Sponsorship details
  amount          Int      // Amount in GHS (Ghana Cedis)
  paymentStatus   String   @default("pending") // pending, paid
  paidAt          DateTime?

  // Relationships
  programParticipants ProgramParticipant[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([paymentStatus])
  @@index([email])
  @@map("sponsors")
}

// ============================================================================
// FACILITATORS (FACILITATOR-001)
// ============================================================================
// Tracks co-facilitators and their mentoring capacity

model Facilitator {
  id              String   @id @default(cuid())

  userId          String   @unique
  user            User     @relation("UserAsFacilitator", fields: [userId], references: [id], onDelete: Cascade)

  // Co-facilitation readiness
  readyToCoFacilitate Boolean @default(false)
  coFacilitationsCount Int   @default(0)

  // Mentoring capacity
  mentorCount     Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([readyToCoFacilitate])
  @@map("facilitators")
}

// ============================================================================
// TESTIMONIES WITH VIDEOS (TESTIMONY-001)
// ============================================================================
// Extended testimony model with before/after videos

model TestimonyVideo {
  id              String   @id @default(cuid())

  participantId   String
  participant     User     @relation("TestimoniesAsParticipant", fields: [participantId], references: [id], onDelete: Cascade)

  // Video URLs (Supabase Storage)
  beforeVideoUrl  String   // Video showing situation before program
  afterVideoUrl   String   // Video showing transformation after program
  youtubeUrl      String?  // Optional YouTube published URL

  // Publishing
  status          String   @default("draft") // draft, published
  publishedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([participantId])
  @@map("testimony_videos")
}

// ============================================================================
// CONTENT ENGINE V3 (CONTENT-ENGINE-V3)
// ============================================================================

model ContentInput {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())

  // Raw input from user
  statement     String @db.Text
  category      String @default("general") // "fraud", "deliverance", "identity", etc.
  context       String? @db.Text
  sourceType    String? // "direct", "youtube", "podcast", "webpage"
  sourceUrl     String?

  // Processing status
  status        String @default("pending") // "pending" | "expanded" | "published"

  // Relationships
  narrative     ExpandedNarrative?
  userId        String?
  user          User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt     DateTime @updatedAt
  @@map("content_inputs")
}

model ExpandedNarrative {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())

  // The expanded narrative
  narrative         String @db.Text

  // Extracted elements
  revelation        String @db.Text
  contrast          String @db.Text
  coreMessage       String @db.Text
  identityChoice    String // What identity is being chosen?
  callToAction      String @db.Text

  // Frame applied
  frame             String @default("enlighten") // "counsel" | "advise" | "uplift" | "enlighten" | "educate"

  // Generated outputs
  outputs           GeneratedOutput[]

  // Tracking
  voiceValidationScore Float? // 0-100, how authentic is this narrative?
  voiceValidationNotes  String? @db.Text

  contentInput      ContentInput @relation(fields: [contentInputId], references: [id], onDelete: Cascade)
  contentInputId    String @unique

  updatedAt         DateTime @updatedAt
  @@map("expanded_narratives")
}

model GeneratedOutput {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())

  // Format type
  format            String // "daily-letter" | "social-post" | "micro-insight" | "devotional" | "article" | "short-video" | "long-video" | "podcast-moment" | "email"

  // The generated content
  content           String @db.Text
  title             String?

  // Metadata
  wordCount         Int?
  duration          String? // for videos/audio

  // Publishing
  status            String @default("draft") // "draft" | "published" | "scheduled"
  publishedUrl      String?
  publishedAt       DateTime?

  // Quality
  voiceValidation   String? @db.Text // Notes on voice consistency

  narrative         ExpandedNarrative @relation(fields: [narrativeId], references: [id], onDelete: Cascade)
  narrativeId       String

  updatedAt         DateTime @updatedAt
  @@map("generated_outputs")
}

// Extend RestorationStage and UserRestoration models with new relationships
// (already defined above, updated to include cohort relationships)

// Extend User model with new relationships
// Add to User model relationships: PrayerCalls, Programs, ProgramParticipants, Facilitator, TestimoniesAsParticipant

// ============================================================================
// VOICE ENGINE (VOICE-ENGINE-001)
// ============================================================================
// Stores teaching transcripts and extracted wisdom pieces

model VoiceTranscript {
  id              String   @id @default(cuid())

  // Source info
  transcript      String   @db.Text
  title           String?

  // Extracted metadata
  mainRevelation  String?

  // Relationships
  wisdomPieces    WisdomPiece[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
  @@map("voice_transcripts")
}

model WisdomPiece {
  id              String   @id @default(cuid())

  // Source
  transcriptId    String
  transcript      VoiceTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  // Extracted content
  exact_quote     String   @db.Text
  claim           String   @db.Text
  premises        String[] @default([])
  conclusion      String   @db.Text

  // VALIDITY Assessment
  validity_structure              String?
  validity_logical_flow           String?
  validity_structure_valid        Boolean @default(true)

  // PREMISES Assessment (stored as JSON)
  premise_assessments_json        String  @db.Text @default("[]")

  // Three-layered presentation
  presentation_analytical        String  @db.Text
  presentation_resistant         String  @db.Text
  presentation_accepting         String  @db.Text

  // Strongest case
  strongest_case  String   @db.Text

  // Video scripts
  reflective_question   String   @db.Text
  reflective_statement  String   @db.Text

  // Status & metadata
  status          String   @default("draft") // "draft" | "approved" | "published"
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([transcriptId])
  @@index([status])
  @@index([createdAt])
  @@map("wisdom_pieces")
}
