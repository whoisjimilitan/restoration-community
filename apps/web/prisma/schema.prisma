// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authentication: User manages email, password, sessions
model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  emailVerified         DateTime?
  password              String
  role                  Role      @default(PARTICIPANT)
  onboardingCompleted   Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relationships
  profile                Profile?
  userRestoration        UserRestoration?
  transitionsApproved    StageTransition[]
  sessions               Session[]
  accounts               Account[]

  @@map("users")
}

// Ministry Data: Profile manages restoration-specific information
model Profile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName           String
  preferredName         String?
  countryRegion         String?
  timeZone              String?
  bio                   String?
  profilePhotoUrl       String?
  covenantAccepted      Boolean  @default(false)
  covenantAcceptedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

// Auth.js Sessions
model Session {
  id        String   @id @default(cuid())
  sessionToken String  @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

// Auth.js Accounts (for OAuth in future)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Role-based authorization
enum Role {
  VISITOR
  PARTICIPANT
  MENTOR
  COMMUNITY_LEADER
  ADMIN
}

// Restoration Journey: The seven immutable stages
model RestorationStage {
  id        Int      @id @default(autoincrement())
  key       String   @unique // "truth", "confession", "repentance", etc.
  name      String   // "Truth", "Confession", etc.
  sequence  Int      @unique // 1-7, enforces order

  content             StageContent?
  currentStageUsers   UserRestoration[] @relation("CurrentStage")
  fromTransitions     StageTransition[] @relation("FromStage")
  toTransitions       StageTransition[] @relation("ToStage")
  reflections         StageReflection[]

  @@index([sequence])
  @@map("restoration_stages")
}

// Editable teaching material for each stage (versionable)
model StageContent {
  id          Int     @id @default(autoincrement())
  stageId     Int     @unique
  stage       RestorationStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  description String  // Full description of the stage
  scripture   String? // Key scriptures
  guidance    String? // Pastoral guidance
  resources   Json?   // Future-proof: PDF URLs, video links, lesson IDs, etc.

  version     Int     @default(1)
  createdAt   DateTime @default(now())
  publishedAt DateTime? // When this version was published
  updatedAt   DateTime @updatedAt

  @@map("stage_content")
}

// User's restoration journey (one per user)
model UserRestoration {
  id              Int     @id @default(autoincrement())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentStageId  Int
  currentStage    RestorationStage @relation("CurrentStage", fields: [currentStageId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transitions     StageTransition[]
  reflections     StageReflection[]

  @@map("user_restorations")
}

// Immutable history of stage progressions
model StageTransition {
  id                  Int     @id @default(autoincrement())
  userRestorationId   Int
  userRestoration     UserRestoration @relation(fields: [userRestorationId], references: [id], onDelete: Cascade)

  fromStageId         Int
  fromStage           RestorationStage @relation("FromStage", fields: [fromStageId], references: [id])

  toStageId           Int
  toStage             RestorationStage @relation("ToStage", fields: [toStageId], references: [id])

  transitionedAt      DateTime @default(now())
  transitionedById    String?
  transitionedBy      User?    @relation(fields: [transitionedById], references: [id], onDelete: SetNull)
  reason              String?  // Why the transition occurred

  createdAt           DateTime @default(now())

  @@index([userRestorationId])
  @@index([transitionedAt])
  @@map("stage_transitions")
}

// User reflections at each stage (stackable)
model StageReflection {
  id                  Int     @id @default(autoincrement())
  userRestorationId   Int
  userRestoration     UserRestoration @relation(fields: [userRestorationId], references: [id], onDelete: Cascade)

  stageId             Int
  stage               RestorationStage @relation(fields: [stageId], references: [id])

  reflection          String  // User's personal note/reflection
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userRestorationId])
  @@index([stageId])
  @@map("stage_reflections")
}
