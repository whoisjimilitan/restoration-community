# Copy this file to .env.local and fill in the values
# Do NOT commit .env.local to git — it contains secrets

# Email Platform (MailerLite)
# Get from: MailerLite dashboard → Profile → API
MAILERLITE_API_KEY=your_mailerlite_api_key_here

# Notion
# Database ID: 3efb5217e90e8067b776f1d90ac77dd6
# Get API key from: Notion → Settings → Integrations → Internal Integrations
NOTION_API_KEY=ntn_your_notion_api_key_here
NOTION_DATABASE_ID=3efb5217e90e8067b776f1d90ac77dd6

# Stripe (Optional, can add later)
# Get from: Stripe dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Site Configuration
SITE_URL=https://brotherjimi.com
